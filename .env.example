# Archived PHP backend only. The active browser app uses the key field in the UI.
# Copy to .env in the repository root, NEVER in public.
# Alternatively use environment variables in the PHP process.
DEEPSEEK_API_KEY=
# An available model name, without quotes.
# See https://api-docs.deepseek.com/api/list-models
DEEPSEEK_MODEL=
# For a configuration file outside the repository, set DEEPCAD_ENV_FILE
# in the PHP process environment, not in this file.
